;================================================================
; LSI露光装置 シーケンス制御プログラム
; PLC: 三菱電機 MELSEC iQ-R 互換ニモニック
; I/O割付:
;   X0000: ワーク搬入センサ        X0001: アライメント完了信号
;   X0002: 露光完了信号            X0003: 検査完了信号
;   X0004: 非常停止SW             X0005: ウェハ有無センサ
;   X0006: ロボットアーム原点      X0007: 真空吸着確認
;   X0008: チャック完了            X0009: 搬出コンベア空き
;   X000A: NG選別完了              X000B: OK選別完了
;   Y0000: 搬入コンベア駆動        Y0001: ロボットアーム起動
;   Y0002: 真空チャック ON         Y0003: アライメントステージ駆動
;   Y0004: 露光シャッター開        Y0005: 検査カメラ起動
;   Y0006: OK搬出コンベア         Y0007: NG排出シュート
;   Y0008: 警報ランプ             Y0009: 完了ランプ
;   Y000A: ステージX軸駆動        Y000B: ステージY軸駆動
;   Y000C: ステージθ軸駆動       Y000D: 搬出ロボット起動
;   M0:    初期化完了フラグ        M1: 搬送中フラグ
;   M2:    アライメント中フラグ    M3: 露光中フラグ
;   M4:    検査中フラグ            M5: 選別中フラグ
;   M10:   位置ズレ検出フラグ      M11: OK判定フラグ
;   M12:   NG判定フラグ            M20: 非常停止フラグ
;   D0:    X軸ズレ量(μm*10)       D1: Y軸ズレ量(μm*10)
;   D2:    θ軸ズレ量(0.001°)      D3: 補正X指令値
;   D4:    補正Y指令値             D5: 補正θ指令値
;   D10:   ステップカウンタ        D20: NG枚数カウンタ
;   D21:   OK枚数カウンタ          D30: 露光時間設定(ms)
;   T0:    搬送タイムアウトタイマ  T1: 露光タイマ
;   T2:    安定待ちタイマ          T3: 検査タイマ
;================================================================

;----------------------------------------------------------------
; ネットワーク 1: 非常停止処理
;----------------------------------------------------------------
LD      X0004           ; 非常停止SW
OR      M20             ; 非常停止フラグ
ANI     X0004           ; (保持回路)
OUT     M20             ; 非常停止フラグセット

LD      M20
RST     Y0000           ; 搬入コンベア停止
RST     Y0001           ; ロボットアーム停止
RST     Y0002           ; 真空チャックOFF
RST     Y0003           ; アライメントステージ停止
RST     Y0004           ; 露光シャッター閉
RST     Y000A           ; ステージX軸停止
RST     Y000B           ; ステージY軸停止
RST     Y000C           ; ステージθ軸停止
SET     Y0008           ; 警報ランプON

;----------------------------------------------------------------
; ネットワーク 2: システム初期化
;----------------------------------------------------------------
LD      SM400           ; 常時ON (初回スキャン)
ANI     M0              ; 未初期化時
ANI     M20             ; 非常停止でない
MOV     K0   D0         ; X軸ズレ量クリア
MOV     K0   D1         ; Y軸ズレ量クリア
MOV     K0   D2         ; θ軸ズレ量クリア
MOV     K100 D30        ; 露光時間 100ms設定
MOV     K0   D10        ; ステップカウンタクリア
MOV     K0   D20        ; NG枚数クリア
MOV     K0   D21        ; OK枚数クリア
SET     M0              ; 初期化完了フラグ

;----------------------------------------------------------------
; ネットワーク 3: メインシーケンス ステップ管理
;----------------------------------------------------------------
; === STEP 0: ワーク搬入待機 ===
LD      M0              ; 初期化完了
ANI     M20             ; 非常停止でない
ANI     M1              ; 搬送中でない
= K0    D10             ; ステップ0
OUT     Y0000           ; 搬入コンベア駆動

LD      X0000           ; ワーク搬入センサON
ANI     M20
= K0    D10
MOV     K1   D10        ; ステップ1へ

; === STEP 1: ロボットアームでウェハ把持 ===
LD      M0
ANI     M20
= K1    D10
SET     Y0001           ; ロボットアーム起動
SET     M1              ; 搬送中フラグ
RST     Y0000           ; 搬入コンベア停止

LD      X0006           ; ロボット原点確認
ANI     X0005           ; ウェハ無し(反転:有り検出)
= K1    D10
SET     Y0002           ; 真空チャックON

LD      X0007           ; 真空吸着確認
= K1    D10
MOV     K2   D10        ; ステップ2へ

; タイムアウト監視
LD      M1
= K1    D10
OUT     T0  K300        ; 30秒タイムアウト

LD      T0              ; タイムアウト
SET     M20             ; 非常停止

; === STEP 2: アライメントステージへ搬送・セット ===
LD      M0
ANI     M20
= K2    D10
SET     Y0003           ; アライメントステージ駆動
SET     M2              ; アライメント中フラグ
RST     M1              ; 搬送中フラグ解除

OUT     T2  K20         ; 安定待ち 2秒

LD      T2
= K2    D10
MOV     K3   D10        ; ステップ3へ

; === STEP 3: 位置ズレ検出 (カメラ計測→D0,D1,D2へ格納) ===
; ※ 実際の計測値はC++経由でPLC共有メモリに書き込まれる
LD      M0
ANI     M20
= K3    D10
SET     M10             ; 位置ズレ検出フラグ(C++側へトリガ)

LD      M10             ; C++側から計測完了信号待ち
AND     X0001           ; アライメント計測完了
= K3    D10
RST     M10
MOV     K4   D10        ; ステップ4へ

; === STEP 4: 位置ズレ量チェック・補正指令 ===
LD      M0
ANI     M20
= K4    D10
; X方向ズレ量チェック (±50μm = ±500 in D0)
LD>     D0   K500       ; X+50μm超過
OR<     D0   K-500      ; X-50μm超過
SET     M12             ; NG判定(補正不可)
MOV     K8   D10        ; ステップ8(NG処理)へ

LD      M0
ANI     M20
ANI     M12
= K4    D10
; 補正指令値セット
MOV     D0   D3         ; X補正指令
MOV     D1   D4         ; Y補正指令
MOV     D2   D5         ; θ補正指令
; X軸補正駆動
SET     Y000A           ; ステージX軸駆動
SET     Y000B           ; ステージY軸駆動
SET     Y000C           ; ステージθ軸駆動
MOV     K5   D10        ; ステップ5へ

; === STEP 5: 補正完了待ち・再計測 ===
LD      M0
ANI     M20
= K5    D10
LD      X0001           ; アライメント完了信号
RST     Y000A
RST     Y000B
RST     Y000C
OUT     T2  K10         ; 安定待ち 1秒

LD      T2
= K5    D10
; 再計測して残留ズレ確認
LD<     D0   K50        ; 残留X < 5μm
AND>    D0   K-50
AND<    D1   K50        ; 残留Y < 5μm
AND>    D1   K-50
AND<    D2   K10        ; 残留θ < 0.01°
AND>    D2   K-10
MOV     K6   D10        ; 合格→ステップ6へ

; === STEP 6: 露光実行 ===
LD      M0
ANI     M20
= K6    D10
RST     M2              ; アライメント中解除
SET     M3              ; 露光中フラグ
SET     Y0004           ; 露光シャッター開

OUT     T1  D30         ; 露光タイマ (D30に設定値)

LD      T1              ; 露光時間完了
RST     Y0004           ; 露光シャッター閉
RST     M3              ; 露光中フラグ解除
AND     X0002           ; 露光完了信号確認
MOV     K7   D10        ; ステップ7へ

; === STEP 7: 検査実行 ===
LD      M0
ANI     M20
= K7    D10
SET     M4              ; 検査中フラグ
SET     Y0005           ; 検査カメラ起動

OUT     T3  K50         ; 検査時間 5秒待ち

LD      T3
= K7    D10
AND     X0003           ; 検査完了信号

LD      X0003           ; 検査完了
AND     M4
; OK/NG判定はC++側から M11/M12 に書き込まれる
LD      M11             ; OK判定フラグ
MOV     K9   D10        ; OK→ステップ9へ
INC     D21             ; OK枚数カウントアップ

LD      M12             ; NG判定フラグ  
ANI     M11
MOV     K8   D10        ; NG→ステップ8へ

; === STEP 8: NG処理・排出 ===
LD      M0
ANI     M20
= K8    D10
RST     M4              ; 検査中解除
SET     M5              ; 選別中フラグ
SET     Y0007           ; NGシュート開
SET     Y000D           ; 搬出ロボット起動
INC     D20             ; NG枚数カウントアップ

LD      X000A           ; NG選別完了
= K8    D10
RST     Y0007
RST     Y000D
RST     M5
RST     M12
MOV     K0   D10        ; ステップ0に戻る

; === STEP 9: OK処理・次工程搬送 ===
LD      M0
ANI     M20
= K9    D10
RST     M4              ; 検査中解除
SET     M5              ; 選別中フラグ
SET     Y0006           ; OKコンベア起動
SET     Y000D           ; 搬出ロボット起動
SET     Y0009           ; 完了ランプON

LD      X000B           ; OK搬出完了
= K9    D10
RST     Y0006
RST     Y000D
RST     M5
RST     M11
RST     Y0009
MOV     K0   D10        ; ステップ0に戻る(次ワーク)

;----------------------------------------------------------------
; ネットワーク 4: 生産統計モニタ
;----------------------------------------------------------------
LD      SM412           ; 1秒サイクルフラグ
; 良品率計算 D21/(D20+D21)*100 → D50
LD      SM400
MOV     D21  D50
; ※実際はFLOAT演算でC++側で処理

END